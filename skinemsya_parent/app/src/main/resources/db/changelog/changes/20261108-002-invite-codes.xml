<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261108-002-invite-codes" author="skinemsya">
        <addColumn tableName="groups">
            <column name="invite_code" type="VARCHAR(32)"/>
        </addColumn>
        <addColumn tableName="events">
            <column name="invite_code" type="VARCHAR(32)"/>
        </addColumn>
        <sql>
            UPDATE groups
            SET invite_code = md5(id::text || random()::text || clock_timestamp()::text)
            WHERE invite_code IS NULL;
            UPDATE events
            SET invite_code = md5(id::text || random()::text || clock_timestamp()::text)
            WHERE invite_code IS NULL;
        </sql>
        <addNotNullConstraint tableName="groups" columnName="invite_code" columnDataType="VARCHAR(32)"/>
        <addNotNullConstraint tableName="events" columnName="invite_code" columnDataType="VARCHAR(32)"/>
        <addUniqueConstraint tableName="groups" columnNames="invite_code" constraintName="uq_groups_invite_code"/>
        <addUniqueConstraint tableName="events" columnNames="invite_code" constraintName="uq_events_invite_code"/>
    </changeSet>

</databaseChangeLog>
