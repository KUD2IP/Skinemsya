<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261116-001-free-receipt-parse" author="skinemsya">
        <createTable tableName="subscription_free_parse">
            <column name="user_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_subscription_free_parse"
                             foreignKeyName="fk_subscription_free_parse_user" references="users(id)"/>
            </column>
            <column name="used_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
