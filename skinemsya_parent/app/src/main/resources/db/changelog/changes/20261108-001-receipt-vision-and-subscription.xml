<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261108-001-receipt-vision-and-subscription" author="skinemsya">
        <addColumn tableName="receipts">
            <column name="image_sha256" type="VARCHAR(64)"/>
            <column name="total_kopecks" type="BIGINT"/>
            <column name="items_sum_kopecks" type="BIGINT"/>
        </addColumn>
        <createIndex tableName="receipts" indexName="idx_receipts_image_sha256">
            <column name="image_sha256"/>
        </createIndex>

        <createTable tableName="subscriptions">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_subscriptions_user"
                             foreignKeyName="fk_subscriptions_user" references="users(id)"/>
            </column>
            <column name="provider" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="current_period_end" type="TIMESTAMPTZ"/>
            <column name="cancel_at_period_end" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="yookassa_payment_method_id" type="VARCHAR(128)"/>
            <column name="stars_charge_id" type="VARCHAR(128)"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="subscription_payments">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_subscription_payments_user" references="users(id)"/>
            </column>
            <column name="provider" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="external_id" type="VARCHAR(128)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_subscription_payments_external"/>
            </column>
            <column name="amount_kopecks" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="kind" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="subscription_parse_usage">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_parse_usage_user" references="users(id)"/>
            </column>
            <column name="usage_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="parse_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="subscription_parse_usage"
                             columnNames="user_id, usage_date"
                             constraintName="uq_parse_usage_user_date"/>
    </changeSet>

</databaseChangeLog>
